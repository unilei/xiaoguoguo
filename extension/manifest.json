{
  "manifest_version": 3,
  "name": "红果短剧 · 全集解锁",
  "version": "0.1.0",
  "description": "在红果短剧官网解锁全部剧集：匿名解析任意一集的播放地址并在浏览器内解密播放。",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.hongguoduanju.com/*",
    "https://*.fqnovel.com/*",
    "https://*.fqnovelpic.com/*",
    "https://*.qznovelvod.com/*",
    "https://*.byteimg.com/*",
    "https://*.douyinpic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hongguoduanju.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
